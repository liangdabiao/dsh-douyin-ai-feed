{
  "name": "dsh-douyin-ai-feed",
  "version": "0.1.0",
  "description": "AI 抖音日报 · 每日扫描抖音 AI 相关热门作品：16 点日期规则、type/topic 两轮自动聚类、互动量排序、深色青风 HTML 日报（封面图/数据指标/日期导航），侧栏看板。需 RedFox API Key，移植自 redfox-data/redfox-community skills/douyin-ai-feed。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "lib",
    "lab",
    "skills",
    "assets",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "tiktok",
    "ai-news",
    "daily-report",
    "feed"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "live": "node scripts/live.mjs",
    "dev": "node scripts/devserver.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
